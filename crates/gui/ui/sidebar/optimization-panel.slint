import { SidebarPanelHeader, SidebarPanelContent } from "./sidebar-panel.slint";
import { AppState } from "../app-state.slint";
import { Theme } from "../theme.slint";

export component OptimizationPanel inherits VerticalLayout {
  SidebarPanelHeader { label: "Document"; }
  SidebarPanelContent {
    VerticalLayout {
      spacing: 12px;
      HorizontalLayout {
        Text { text: "Original size"; color: Theme.muted; }
        Text { text: AppState.svg-loaded ? AppState.original-size : "—"; color: Theme.text; horizontal-alignment: right; }
      }
      HorizontalLayout {
        Text { text: "Optimized size"; color: Theme.muted; }
        Text { text: AppState.svg-loaded ? AppState.optimized-size : "—"; color: Theme.accent; horizontal-alignment: right; }
      }
    }
  }
}
