import { ProgressIndicator } from "std-widgets.slint";
import { AppState } from "./app-state.slint";
import { Theme } from "./theme.slint";

export component StatusBar inherits Rectangle {
  height: 30px;
  background: Theme.panel;
  HorizontalLayout {
    padding-left: 16px;
    padding-right: 16px;
    spacing: 12px;
    alignment: start;
    if AppState.loading && !AppState.loading-dialog: ProgressIndicator {
      width: 72px;
      height: 4px;
      indeterminate: true;
    }
    Text {
      text: AppState.loading ? AppState.loading-status : AppState.svg-loaded ? "Ready" : "Open an SVG to get started";
      color: Theme.muted;
      font-size: 11px;
      vertical-alignment: center;
    }
    Rectangle { horizontal-stretch: 1; }
    if AppState.svg-loaded: Text {
      text: "Scroll to zoom  ·  Drag or middle-drag to pan  ·  Double-click to fit";
      color: Theme.muted;
      font-size: 11px;
      vertical-alignment: center;
    }
  }
}
