import { ProgressIndicator, Palette } from "std-widgets.slint";
import { AppState } from "./app-state.slint";

export component LoadingDialog inherits Rectangle {
  // Covers the full parent area and blocks pointer events
  background: #00000066;

  TouchArea {
    width: 100%;
    height: 100%;
  }

  Rectangle {
    width: 260px;
    height: 80px;
    x: (parent.width - self.width) / 2;
    y: (parent.height - self.height) / 2;
    background: Palette.background;
    border-radius: 5px;
    drop-shadow-blur: 24px;
    drop-shadow-offset-y: 4px;
    drop-shadow-color: #00000044;

    VerticalLayout {
      padding: 24px;
      spacing: 14px;
      alignment: center;

      Text {
        text: AppState.loading-status;
        horizontal-alignment: center;
        color: Palette.foreground;
      }

      ProgressIndicator {
        indeterminate: true;
      }
    }
  }
}
