import { ScrollView } from "std-widgets.slint";
import { PluginsPanel } from "./plugins-panel.slint";
import { OptimizationPanel } from "./optimization-panel.slint";
import { ExportPanel } from "./export-panel.slint";
import { Theme } from "../theme.slint";

export component Sidebar inherits Rectangle {
  width: 316px;
  horizontal-stretch: 0;
  background: Theme.panel;
  ScrollView {
    horizontal-scrollbar-policy: always-off;
    VerticalLayout {
      spacing: 1px;
      padding: 0px;
      alignment: start;
      OptimizationPanel {}
      ExportPanel {}
      PluginsPanel {}
    }
  }
}
