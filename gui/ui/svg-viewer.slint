import { NButton } from "./components/button.slint";
import { Theme } from "./theme.slint";
import { AppState } from "./app-state.slint";

export component SvgViewer inherits Rectangle {
  callback open-file();
  property <float> fit-zoom: AppState.svg-width > 0px && AppState.svg-height > 0px
    ? max(0.01, min(1.0, min((root.width - 80px) / AppState.svg-width, (root.height - 80px) / AppState.svg-height))) : 1.0;
  property <float> zoom: root.fit-zoom;
  property <bool> loaded: AppState.svg-loaded;
  changed loaded => {
    if root.loaded { root.reset-view(); }
  }
  function apply-zoom(next-zoom: float, anchor-x: length, anchor-y: length) {
    root.pan_x = anchor-x - (anchor-x - root.pan_x) * next-zoom / root.zoom;
    root.pan_y = anchor-y - (anchor-y - root.pan_y) * next-zoom / root.zoom;
    root.zoom = next-zoom;
  }
  function reset-view() {
    root.zoom = root.fit-zoom;
    root.pan_x = (root.width - AppState.svg-width * root.zoom) / 2;
    root.pan_y = (root.height - AppState.svg-height * root.zoom) / 2;
  }
  property <float> max_zoom: 6.0;

  property <length> pan_x: (root.width - AppState.svg-width * root.zoom) / 2;
  property <length> pan_y: (root.height - AppState.svg-height * root.zoom) / 2;
  property <bool> is_panning: false;
  property <length> last_mouse_x;
  property <length> last_mouse_y;

  clip: true;
  horizontal-stretch: 1;
  vertical-stretch: 1;
  background: Theme.background;

  if AppState.svg-loaded: Rectangle {
    x: root.pan_x;
    y: root.pan_y;
    width: AppState.svg-width * root.zoom;
    height: AppState.svg-height * root.zoom;
    clip: true;
    for row in Math.ceil(self.height / 256px): Rectangle {
      y: row * 256px;
      height: 256px;
      width: parent.width;
      for column in Math.ceil(self.width / 256px): Image {
        x: column * 256px;
        width: 256px;
        height: 256px;
        source: AppState.checker-image;
        image-fit: fill;
        image-rendering: pixelated;
      }
    }
  }

  TouchArea {
    scroll-event(event) => {
      if (AppState.zoom-enabled) {
        if event.delta-y != 0 {
          root.apply-zoom(event.delta-y > 0 ? min(max_zoom, zoom * 1.1) : max(0.1, zoom / 1.1), self.mouse-x, self.mouse-y);
        }
      }
      accept
    }

    pointer-event(event) => {
      if (AppState.zoom-enabled && event.button == PointerEventButton.left) {
        if (event.kind == PointerEventKind.down) {
          root.is_panning = true;
          root.last_mouse_x = self.mouse-x;
          root.last_mouse_y = self.mouse-y;
        } else {
          root.is_panning = false;
        }
      }
    }

    moved() => {
      if (root.is_panning) {
        root.pan_x += self.mouse-x - root.last_mouse_x;
        root.pan_y += self.mouse-y - root.last_mouse_y;
        root.last_mouse_x = self.mouse-x;
        root.last_mouse_y = self.mouse-y;
      }
    }

    Image {
      source: AppState.show-optimized ? AppState.svg-image-optimized : AppState.svg-image-original;
      x: root.pan_x;
      y: root.pan_y;
      width: AppState.svg-width * root.zoom;
      height: AppState.svg-height * root.zoom;
      image-fit: fill;
    }
  }

  if !AppState.svg-loaded: Rectangle {
    width: min(360px, root.width - 48px);
    height: 64px;
    x: (root.width - self.width) / 2;
    y: (root.height - self.height) / 2;
    VerticalLayout {
      spacing: 12px;
      alignment: center;
      HorizontalLayout {
        alignment: center;
        NButton { text: "Open SVG…"; primary: true; clicked => { root.open-file(); } }
      }
      Text {
        text: "Open an SVG file to start";
        color: Theme.muted;
        font-size: 12px;
        horizontal-alignment: center;
      }
    }
  }

  if AppState.svg-loaded: Rectangle {
    x: 16px;
    y: 16px;
    width: 164px;
    height: 34px;
    background: Theme.panel;
    border-radius: 4px;
    HorizontalLayout {
      padding: 3px;
      spacing: 8px;
      Text {
        text: Math.round(root.zoom * 100) + "%";
        color: Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
      }
      NButton { text: "Fit"; height: 28px; clicked => { root.reset-view(); } }
    }
  }
}
