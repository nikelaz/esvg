import { AppState } from "./app-state.slint";
import { NButton } from "./components/button.slint";
import { Theme } from "./theme.slint";

export component TopBar inherits Rectangle {
  callback open-file();
  callback open-bulk-window();
  height: 44px;
  background: Theme.panel;
  HorizontalLayout {
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 12px;
    padding-right: 12px;
    spacing: 20px;
    NButton { text: "Open SVG…"; clicked => { root.open-file(); } }
    NButton { text: "Bulk Optimize…"; clicked => { root.open-bulk-window(); } }
    Rectangle { min-width: 0px; horizontal-stretch: 1; }
    HorizontalLayout {
      horizontal-stretch: 0;
      spacing: 0px;
      NButton {
        text: "Original";
        group: true;
        group-first: true;
        checked: !AppState.show-optimized;
        enabled: AppState.svg-loaded;
        clicked => { AppState.show-optimized = false; }
      }
      NButton {
        text: "Optimized";
        group: true;
        group-last: true;
        checked: AppState.show-optimized;
        enabled: AppState.svg-loaded;
        clicked => { AppState.show-optimized = true; }
      }
    }
  }
}
